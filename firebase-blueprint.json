{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID (matches auth.uid)" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "provider": { "type": "string", "description": "google or password" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "role": { "type": "string", "description": "student or admin" },
        "xp": { "type": "number", "description": "Total XP earned" },
        "totalLogins": { "type": "number", "description": "Login count" },
        "quizzesAttempted": { "type": "number", "description": "Quizzes attempted" },
        "lastLoginAt": { "type": "string", "description": "ISO timestamp of last login" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" }
      }
    },
    "analytics": {
      "title": "Analytics",
      "description": "Aggregated daily or general analytics metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Daily date or global metric key" },
        "pageViews": { "type": "number", "description": "Count of page views" },
        "activeUsers": { "type": "number", "description": "Count of active users" },
        "lastUpdated": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "user_activities": {
      "title": "UserActivity",
      "description": "Live activity event logged for authenticated actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "activityType": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "download_events": {
      "title": "DownloadEvent",
      "description": "Tracks study material and syllabus PDF download actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "resourceName": { "type": "string" },
        "fileType": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "exam_scores": {
      "title": "ExamScore",
      "description": "Exam result scores and statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "quizId": { "type": "string" },
        "quizTitle": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "accuracy": { "type": "number" },
        "timestamp": { "type": "string" }
      }
    },
    "exam_submissions": {
      "title": "ExamSubmission",
      "description": "Live student exam submission records for admin tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "quizId": { "type": "string" },
        "quizTitle": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "accuracy": { "type": "number" },
        "timeTakenSeconds": { "type": "number" },
        "timestamp": { "type": "string" }
      }
    },
    "registered_users": {
      "title": "RegisteredUser",
      "description": "Global registered students and profile tracking records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "district": { "type": "string" },
        "province": { "type": "string" },
        "targetExam": { "type": "string" },
        "totalLogins": { "type": "number" },
        "pagesVisited": { "type": "array", "items": { "type": "string" } },
        "testsTaken": { "type": "number" },
        "isYouTubeSubscribed": { "type": "boolean" },
        "lastLoginAt": { "type": "string" },
        "lastActive": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "registeredAt": { "type": "string" }
      }
    },
    "user_activity_logs": {
      "title": "UserActivityLog",
      "description": "Every page navigation, visit, quiz attempt, and YouTube subscribe click",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "activityType": { "type": "string" },
        "action": { "type": "string" },
        "targetTitle": { "type": "string" },
        "details": { "type": "string" },
        "page": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "isYouTubeSubscribed": { "type": "boolean" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile collection"
    },
    "/registered_users/{userId}": {
      "schema": "registered_users",
      "description": "Global registered users table"
    },
    "/user_activity_logs/{logId}": {
      "schema": "user_activity_logs",
      "description": "Mandatory real-time user activity logs"
    },
    "/analytics/{docId}": {
      "schema": "analytics",
      "description": "Application analytics data"
    },
    "/user_activities/{activityId}": {
      "schema": "user_activities",
      "description": "User activity log stream"
    },
    "/download_events/{downloadId}": {
      "schema": "download_events",
      "description": "Study material PDF download events"
    },
    "/exam_scores/{scoreId}": {
      "schema": "exam_scores",
      "description": "Completed exam score records"
    },
    "/exam_submissions/{submissionId}": {
      "schema": "exam_submissions",
      "description": "Live exam submissions collection for admin monitoring"
    }
  }
}
