rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - synchronized user profiles and subcollections
    match /users/{userId} {
      allow read, write: if true;
    }
    match /users/{userId}/{allSubcollections=**} {
      allow read, write: if true;
    }

    // Explicit global database tables for admin-only tracking
    match /registered_users/{userId} {
      allow read, write: if true;
    }
    match /user_activity_logs/{logId} {
      allow read, write: if true;
    }
    
    // Global exam results & submissions for all users (guests and authenticated)
    match /global_exam_results/{resultId} {
      allow read, write: if true;
    }
    match /exam_submissions/{submissionId} {
      allow read, write: if true;
    }
    match /exam_scores/{scoreId} {
      allow read, write: if true;
    }
    match /chat_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /test_evaluations/{evalId} {
      allow read, write: if true;
    }

    // Analytics & visitor logs
    match /analytics/{docId} {
      allow read, write: if true;
    }
    match /visitor_logs/{logId} {
      allow read, write: if true;
    }
    match /quiz_attempts/{attemptId} {
      allow read, write: if true;
    }
    match /user_activities/{activityId} {
      allow read, write: if true;
    }
    match /download_events/{downloadId} {
      allow read, write: if true;
    }
  }
}
